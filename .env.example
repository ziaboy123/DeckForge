# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deckforge"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional: where card pictures come from (default /millenniumarena/img, Millennium Arena's copies on the same site).
# For local development use the live site's copies:
# NEXT_PUBLIC_CARD_IMAGES="https://daniyalzia.co.uk/millenniumarena/img"

# Optional: where the downloaded card data is kept (default: data/ in the project folder)
# CARD_DATA_DIR="/path/to/card-data"
